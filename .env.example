# Copy to .env for local development. In production, set the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit .env.

# Production origin used for canonical URLs, Open Graph tags, JSON-LD,
# sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.nexoratechsolutionsllc.com

# Optional: Google Maps Embed API key. Without it the contact-page map uses
# Google's keyless embed, which works fine.
VITE_GOOGLE_MAPS_EMBED_KEY=

# ---- Server-only (used by api/contact.js; never exposed to the browser) ----
# Gmail account that sends the contact-form emails, and its 16-character
# app password (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Inbox that receives form submissions.
CONTACT_TO=minchu@nexoratechsolutionsllc.com

# ---- Cloudflare Turnstile (bot check on the contact forms) ----
# Secret key: server-only. Site key: public, embedded in the page.
# Cloudflare dashboard → Turnstile → your widget. Add every hostname you use
# (your domain, *.vercel.app previews, and localhost for local testing).
TURNSTILE_SECRET_KEY=0x4AAAAAAA-your-secret-key
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA-your-site-key

# ---- Anti-CSRF form tokens (server-only) ----
# HMAC key that signs the token the contact form must send back. Required on
# Vercel. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_TOKEN_SECRET=replace-with-64-random-hex-characters

# Extra origins allowed to call /api cross-origin (the site's own origin is
# always allowed). Comma-separated, no trailing slash. Leave empty in
# production unless another site of yours posts to this API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Local testing only: set to 1 to run the whole form flow without actually
# sending email (ignored on Vercel).
CONTACT_DRY_RUN=

# ---- Supabase Configuration (Form Submissions Storage & Admin Panel) ----
# Public client credentials
VITE_SUPABASE_URL=https://njhuxhzlxhonzbxasljg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_SlNqbg_8plmGN-I6xGIbkw_BxgHgqQA
# Server credentials
SUPABASE_URL=https://njhuxhzlxhonzbxasljg.supabase.co
SUPABASE_ANON_KEY=sb_publishable_SlNqbg_8plmGN-I6xGIbkw_BxgHgqQA
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.njhuxhzlxhonzbxasljg.supabase.co:5432/postgres

