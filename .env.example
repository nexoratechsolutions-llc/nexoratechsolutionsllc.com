# ---------------------------------------------------------------------------
# Nexora TechSolutions — environment variables
# Copy to .env.local for local dev; set the same keys in the Vercel dashboard.
# NEVER prefix secrets with VITE_ — anything VITE_* is bundled into the client.
# ---------------------------------------------------------------------------

# --- Mail transport ---------------------------------------------------------
# Preferred: Gmail SMTP. Create an app password at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
# The spaces Google shows in the password are display-only.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# With no credentials set, submissions are validated and logged but not emailed.

# Where form submissions are delivered.
CONTACT_TO_EMAIL=minchu@nexoratechsolutionsllc.com

# Comma-separated origins allowed to POST to the API routes.
ALLOWED_ORIGINS=https://www.nexoratechsolutions.com,https://nexoratechsolutions.com

# Secret used to sign the anti-CSRF form tokens issued by /api/form-token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_TOKEN_SECRET=

# --- Cloudflare Turnstile ---------------------------------------------------
# REQUIRED. Without the secret, every form submission is rejected with 503 —
# it fails closed on purpose, so bot protection is never silently disabled.
# Dashboard: https://dash.cloudflare.com -> Turnstile
TURNSTILE_SECRET_KEY=

# The site key is public (it ships in the page). Set it only to override the
# default baked into src/lib/turnstile.js, e.g. for a staging widget.
VITE_TURNSTILE_SITE_KEY=

# --- Google Maps (contact page) --------------------------------------------
# OPTIONAL. Without it the map uses the keyless embed URL, which works fine.
# Set it to use the official Maps Embed API instead (needs a Google Cloud
# project with billing). Public by design — it ships in the page.
VITE_GOOGLE_MAPS_EMBED_KEY=
